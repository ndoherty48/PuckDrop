<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <AWSProjectType>Lambda</AWSProjectType>
    <!-- This property makes the build directory similar to a publish directory and helps the AWS .NET Lambda Mock Test Tool find project dependencies. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Generate ready to run images during publishing to improve cold start time. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PuckDrop.Application\PuckDrop.Application.csproj" />
    <ProjectReference Include="..\PuckDrop.Infrastructure\PuckDrop.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\Infrastructure\PuckDrop.ServiceDefaults\PuckDrop.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>