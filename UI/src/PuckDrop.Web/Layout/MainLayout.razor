@inherits LayoutComponentBase

<div class="container-fluid p-0">
    <nav class="navbar navbar-expand-md navbar-dark bg-dark sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="">🏒 PuckDrop</a>
            <button class="navbar-toggler" type="button" @onclick="ToggleNav" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="@NavCss">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="leaderboard">Leaderboard</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="history">History</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="admin/polls">Admin</NavLink>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @Body
    </main>
</div>

@code {
    private bool collapseNav = true;
    private string NavCss => collapseNav ? "collapse navbar-collapse" : "navbar-collapse";
    private void ToggleNav() => collapseNav = !collapseNav;
}
