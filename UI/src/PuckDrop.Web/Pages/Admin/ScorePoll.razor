@page "/admin/polls/{PollId}/score"
@attribute [Authorize(Roles = "admin")]
@inject PuckDropApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<h2 class="mb-4">Score Poll</h2>

@if (_loading)
{
    <p>Loading poll...</p>
}
else if (_poll is null)
{
    <p class="text-danger">@(_error ?? "Poll not found.")</p>
}
else
{
    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    <p class="text-muted mb-4">Select the correct answer for each question.</p>

    @foreach (var question in _poll.Questions.OrderBy(q => q.SortOrder))
    {
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="card-title">@question.Text</h6>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    @foreach (var option in question.Options.OrderBy(o => o.SortOrder))
                    {
                        var isSelected = _correctAnswers.TryGetValue(question.QuestionId, out var selectedId)
                                         && selectedId == option.OptionId;
                        <button type="button" class="btn @(isSelected ? "btn-success" : "btn-outline-secondary")"
                                aria-pressed="@isSelected"
                                @onclick="() => SelectAnswer(question.QuestionId, option.OptionId)">
                            @option.Text
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    <div class="mt-4">
        <button class="btn btn-primary btn-lg" @onclick="SubmitScoresAsync"
                disabled="@(!AllQuestionsAnswered || _submitting)">
            @(_submitting ? "Submitting..." : "Submit Scores")
        </button>
        <a href="admin/polls" class="btn btn-outline-secondary btn-lg ms-2">Cancel</a>
    </div>

    @if (!AllQuestionsAnswered)
    {
        <p class="text-muted mt-2">
            Please select an answer for all @_poll.Questions.Count questions
            (@_correctAnswers.Count of @_poll.Questions.Count selected).
        </p>
    }
}

@code {
    [Parameter] public string PollId { get; set; } = "";

    private PollDetailModel? _poll;
    private bool _loading = true;
    private bool _submitting;
    private string? _error;
    private Dictionary<string, string> _correctAnswers = new();

    private bool AllQuestionsAnswered =>
        _poll is not null && _correctAnswers.Count == _poll.Questions.Count;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _poll = await Api.GetPollAsync(PollId);
        }
        catch (Exception)
        {
            _error = "Unable to load poll. Please try again later.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectAnswer(string questionId, string optionId)
    {
        _correctAnswers[questionId] = optionId;
    }

    private async Task SubmitScoresAsync()
    {
        if (!AllQuestionsAnswered || _submitting)
            return;

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Submit these scores? This sets the correct answers and updates the leaderboard.");
        if (!confirmed)
            return;

        _submitting = true;
        _error = null;

        try
        {
            var request = new ScorePollRequest(
                _correctAnswers.Select(kv => new ScoreItem(kv.Key, kv.Value)).ToList()
            );

            await Api.ScorePollAsync(PollId, request);
            Nav.NavigateTo($"results/{PollId}");
        }
        catch (Exception)
        {
            _error = "Failed to submit scores. Please try again.";
            _submitting = false;
        }
    }
}
