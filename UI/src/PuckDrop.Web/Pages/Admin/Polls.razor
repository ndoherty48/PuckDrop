@page "/admin/polls"
@attribute [Authorize(Roles = "admin")]
@inject PuckDropApiClient Api
@inject IJSRuntime JS

<h2 class="mb-4">Manage Polls</h2>

<div class="mb-3">
    <a href="admin/polls/create" class="btn btn-primary">Create Poll</a>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_loading)
{
    <p>Loading polls...</p>
}
else if (_polls is null || _polls.Count == 0)
{
    <p class="text-muted">No polls found for the current season.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Game Date</th>
                <th>Title</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var poll in _polls)
            {
                <tr>
                    <td>@poll.GameDate</td>
                    <td>@poll.Title</td>
                    <td><span class="badge bg-@GetStatusColor(poll.Status)">@poll.Status</span></td>
                    <td>
                        @if (poll.Status is "Draft" or "Open")
                        {
                            <a href="admin/polls/@poll.PollId/edit" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                        }
                        @if (poll.Status == "Draft")
                        {
                            <button class="btn btn-sm btn-success me-1" disabled="@_actionInProgress" @onclick="() => PublishAsync(poll.PollId)">Publish</button>
                        }
                        @if (poll.Status == "Open")
                        {
                            <button class="btn btn-sm btn-warning me-1" disabled="@_actionInProgress" @onclick="() => CloseAsync(poll.PollId)">Close</button>
                        }
                        @if (poll.Status == "Closed")
                        {
                            <a href="admin/polls/@poll.PollId/score" class="btn btn-sm btn-info">Score</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<PollModel>? _polls;
    private bool _loading = true;
    private bool _actionInProgress;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadPollsAsync();
    }

    private async Task LoadPollsAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var season = await Api.GetCurrentSeasonAsync();
            if (season is not null)
            {
                _polls = await Api.GetPollsAsync(season.SeasonId);
            }
            else
            {
                _polls = [];
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PublishAsync(string pollId)
    {
        if (_actionInProgress) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Publish this poll? It will open for voting immediately."))
            return;

        _actionInProgress = true;
        _error = null;
        try
        {
            await Api.PublishPollAsync(pollId);
            await LoadPollsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to publish poll: {ex.Message}";
        }
        finally
        {
            _actionInProgress = false;
        }
    }

    private async Task CloseAsync(string pollId)
    {
        if (_actionInProgress) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Close voting for this poll? This cannot be undone."))
            return;

        _actionInProgress = true;
        _error = null;
        try
        {
            await Api.ClosePollAsync(pollId);
            await LoadPollsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to close poll: {ex.Message}";
        }
        finally
        {
            _actionInProgress = false;
        }
    }

    private static string GetStatusColor(string status) => status switch
    {
        "Draft" => "secondary",
        "Open" => "success",
        "Closed" => "warning",
        "Scored" => "info",
        _ => "light"
    };
}
