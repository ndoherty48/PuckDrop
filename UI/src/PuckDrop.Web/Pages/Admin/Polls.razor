@page "/admin/polls"
@attribute [Authorize(Roles = "admin")]
@inject PuckDropApiClient Api
@inject ConfirmDialogService ConfirmDialog

<div class="pd-page-head">
    <div>
        @if (_seasonName is not null)
        {
            <p class="pd-eyebrow polls-eyebrow">Admin · @_seasonName</p>
        }
        <h1 class="pd-page-title">Manage polls</h1>
    </div>
    <div class="pd-btn-row">
        <a href="admin/leaderboard" class="pd-btn pd-btn-quiet">Point adjustments</a>
        <a href="admin/polls/import" class="pd-btn pd-btn-secondary">Import fixtures</a>
        <a href="admin/polls/create" class="pd-btn pd-btn-primary"><Icon Name="plus" />Create poll</a>
    </div>
</div>

@* Always rendered, so screen readers announce a publish/close confirmation when it appears *@
<div role="status">
    @if (_statusMessage is not null)
    {
        <div class="pd-alert pd-alert-success polls-message">
            <Icon Name="check" />
            <p>@_statusMessage</p>
        </div>
    }
</div>

@if (_error is not null)
{
    <div class="pd-alert pd-alert-danger polls-message" role="alert">
        <Icon Name="alert" />
        <p>@_error</p>
    </div>
}

@if (_polls is null)
{
    @if (_loading)
    {
        <p class="pd-muted" role="status">Loading polls…</p>
    }
}
else if (_polls.Count == 0)
{
    <p class="pd-card pd-muted polls-empty">No polls found for the current season.</p>
}
else
{
    <section class="pd-card polls-table-card">
        <div class="pd-table-wrap">
            <table class="pd-table polls-table">
                <caption class="pd-sr-only">Polls this season, closest game first</caption>
                <thead>
                    <tr>
                        <th scope="col" class="polls-date-col">Game date</th>
                        <th scope="col">Poll</th>
                        <th scope="col" class="polls-status-col">Status</th>
                        @if (_participation is not null)
                        {
                            <th scope="col" class="polls-picks-col">Picks</th>
                        }
                        <th scope="col" class="polls-actions-col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var poll in _polls)
                    {
                        <tr>
                            <td class="pd-tnum">@poll.GameDate.ToString("ddd d MMM yyyy")</td>
                            <th scope="row">@poll.Title</th>
                            <td><PollStatusBadge Status="@poll.Status" /></td>
                            @if (_participation is not null)
                            {
                                <td>@PickCount(poll)</td>
                            }
                            <td><div class="pd-btn-row polls-actions">@Actions(poll)</div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @* Phones: the same polls and actions as cards (the table is hidden below 768px) *@
    <ul class="pd-list-reset polls-cards" aria-label="Polls this season">
        @foreach (var poll in _polls)
        {
            <li class="pd-card polls-card">
                <div class="polls-card-top">
                    <p class="pd-muted pd-tnum polls-card-date">@poll.GameDate.ToString("ddd d MMM yyyy")</p>
                    <div class="polls-card-badges">
                        <PollStatusBadge Status="@poll.Status" />
                        @if (_participation is not null)
                        {
                            @PickCount(poll)
                        }
                    </div>
                </div>
                <h2 class="pd-h3 polls-card-title">@poll.Title</h2>
                <div class="pd-btn-row polls-actions">@Actions(poll)</div>
            </li>
        }
    </ul>
}

@code {
    private List<PollModel>? _polls;
    private SeasonParticipationModel? _participation;
    private string? _seasonName;
    private bool _loading = true;
    private bool _actionInProgress;
    private string? _error;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPollsAsync();
    }

    private async Task LoadPollsAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var season = await Api.GetCurrentSeasonAsync();
            if (season is not null)
            {
                _seasonName = season.Name;
                var polls = await Api.GetPollsAsync(season.SeasonId);
                _polls = polls?.OrderBy(p => p.GameDate).ToList() ?? [];
                _participation = await LoadParticipationAsync(season.SeasonId);
            }
            else
            {
                _polls = [];
            }
        }
        catch (Exception)
        {
            _error = "Unable to load polls. Please try again later.";
        }
        finally
        {
            _loading = false;
        }
    }

    // Pick counts are a nice-to-have: if they fail to load, the page works without them
    private async Task<SeasonParticipationModel?> LoadParticipationAsync(string seasonId)
    {
        try
        {
            return await Api.GetParticipationAsync(seasonId);
        }
        catch (Exception)
        {
            return null;
        }
    }

    private RenderFragment PickCount(PollModel poll) =>
        @<PickCountBadge Status="@poll.Status"
                         Picked="@(_participation!.Polls.FirstOrDefault(p => p.PollId == poll.PollId)?.PickedCount ?? 0)"
                         Players="@_participation.PlayerCount" />;

    private async Task PublishAsync(PollModel poll)
    {
        if (_actionInProgress) return;
        if (!await ConfirmDialog.ShowAsync(
                $"\"{poll.Title}\" will open for voting immediately.",
                title: "Publish this poll?",
                confirmLabel: "Publish"))
            return;

        _actionInProgress = true;
        _error = null;
        _statusMessage = null;
        try
        {
            await Api.PublishPollAsync(poll.PollId);
            await LoadPollsAsync();
            _statusMessage = $"“{poll.Title}” is now open for picks.";
        }
        catch (Exception)
        {
            _error = "Failed to publish poll. Please try again.";
        }
        finally
        {
            _actionInProgress = false;
        }
    }

    private async Task CloseAsync(PollModel poll)
    {
        if (_actionInProgress) return;
        if (!await ConfirmDialog.ShowAsync(
                $"Voting for \"{poll.Title}\" will close. This cannot be undone.",
                title: "Close voting?",
                confirmLabel: "Close voting",
                danger: true))
            return;

        _actionInProgress = true;
        _error = null;
        _statusMessage = null;
        try
        {
            await Api.ClosePollAsync(poll.PollId);
            await LoadPollsAsync();
            _statusMessage = $"Voting is closed for “{poll.Title}”.";
        }
        catch (Exception)
        {
            _error = "Failed to close poll. Please try again.";
        }
        finally
        {
            _actionInProgress = false;
        }
    }

    // Every control repeats per row, so each carries the poll title as hidden text to stay
    // distinct out of context ("Publish Belfast Giants vs Guildford Flames").
    private RenderFragment Actions(PollModel poll) =>
        @<text>
            @if (poll.Status is "Draft" or "Open")
            {
                <a href="admin/polls/@poll.PollId/edit" class="pd-btn pd-btn-quiet pd-btn-sm"><Icon Name="pencil" Size="18" />Edit<span class="pd-sr-only"> @poll.Title</span></a>
            }
            @if (poll.Status == "Draft")
            {
                <button type="button" class="pd-btn pd-btn-primary pd-btn-sm" disabled="@_actionInProgress"
                        @onclick="() => PublishAsync(poll)">Publish<span class="pd-sr-only"> @poll.Title</span></button>
            }
            @if (poll.Status == "Open")
            {
                <button type="button" class="pd-btn pd-btn-quiet pd-btn-sm" disabled="@_actionInProgress"
                        @onclick="() => CloseAsync(poll)"><Icon Name="lock" Size="18" />Close voting<span class="pd-sr-only"> @poll.Title</span></button>
            }
            @if (poll.Status == "Closed")
            {
                <a href="admin/polls/@poll.PollId/score" class="pd-btn pd-btn-primary pd-btn-sm">Score<span class="pd-sr-only"> @poll.Title</span></a>
            }
            @if (poll.Status == "Scored")
            {
                <a href="results/@poll.PollId" class="pd-btn pd-btn-secondary pd-btn-sm">View results<span class="pd-sr-only"> for @poll.Title</span></a>
                @* Re-scoring fixes a wrong correct option, or finishes a partly scored poll. Safe to
                   repeat: totals are folded from each poll's facts, so it overwrites rather than adding. *@
                <a href="admin/polls/@poll.PollId/score" class="pd-btn pd-btn-quiet pd-btn-sm">Re-score<span class="pd-sr-only"> @poll.Title</span></a>
            }
        </text>;
}
