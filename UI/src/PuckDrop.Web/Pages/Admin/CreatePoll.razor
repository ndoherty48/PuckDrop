@page "/admin/polls/create"
@attribute [Authorize(Roles = "admin")]
@inject PuckDropApiClient Api
@inject NavigationManager Nav

<h2 class="mb-4">Create Poll</h2>

<div class="row">
    <div class="col-md-6">
        <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync" FormName="CreatePollForm">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <InputText id="title" class="form-control" @bind-Value="_model.Title" />
            </div>

            <div class="mb-3">
                <label for="gameDate" class="form-label">Game Date</label>
                <InputDate id="gameDate" class="form-control" @bind-Value="_model.GameDate" />
            </div>

            <div class="mb-3">
                <label for="deadline" class="form-label">Deadline</label>
                <InputDate id="deadline" class="form-control" Type="InputDateType.DateTimeLocal" @bind-Value="_model.Deadline" />
            </div>

            <button type="submit" class="btn btn-primary" disabled="@_submitting">
                @(_submitting ? "Creating..." : "Create Poll")
            </button>
            <a href="admin/polls" class="btn btn-outline-secondary ms-2">Cancel</a>
        </EditForm>
    </div>
</div>

@code {
    private CreatePollFormModel _model = new();
    private bool _submitting;

    private async Task HandleSubmitAsync()
    {
        _submitting = true;

        var request = new CreatePollRequest(
            _model.Title,
            _model.GameDate,
            _model.Deadline
        );

        var poll = await Api.CreatePollAsync(request);

        if (poll is not null)
        {
            Nav.NavigateTo($"admin/polls/{poll.PollId}/edit");
        }

        _submitting = false;
    }

    private class CreatePollFormModel
    {
        public string Title { get; set; } = "";
        public DateOnly GameDate { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow);
        public DateTime Deadline { get; set; } = DateTime.Today;
    }
}
