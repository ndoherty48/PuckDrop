@page "/admin/polls/{PollId}/edit"
@attribute [Authorize(Roles = "admin")]
@using System.Net
@inject PuckDropApiClient Api
@inject ConfirmDialogService ConfirmDialog

<nav class="pd-crumbs" aria-label="Breadcrumb">
    <a href="admin/polls">Manage polls</a>
    <Icon Name="right" Size="16" />
    <span aria-current="page">Edit poll</span>
</nav>

@if (_poll is null && _loading)
{
    <p class="pd-muted" role="status">Loading poll…</p>
}
else if (_poll is null)
{
    <h1 class="pd-page-title edit-title">Poll not found</h1>
    <div class="pd-alert pd-alert-danger" role="alert">
        <Icon Name="alert" />
        <p>@(_loadError ?? "This poll doesn't exist or has been removed.")</p>
    </div>
}
else
{
    <div class="edit-head">
        <p class="pd-eyebrow edit-eyebrow">Edit poll</p>
        <h1 class="pd-page-title">@_poll.Title</h1>
        <div class="pd-meta-row">
            <PollStatusBadge Status="@_poll.Status" />
            <span class="pd-meta"><Icon Name="calendar" />@_poll.GameDate.ToString("ddd d MMM yyyy")</span>
            <span class="pd-meta"><Icon Name="clock" />Picks close @_poll.Deadline.ToString("ddd d MMM, HH:mm")</span>
            @if (_poll.Status == "Draft")
            {
                <button type="button" class="pd-btn pd-btn-quiet pd-btn-sm" disabled="@Busy" @onclick="OpenReschedule">
                    <Icon Name="pencil" Size="16" />Edit date and time
                </button>
            }
        </div>
    </div>

    <Modal Title="Edit date and time" Open="@_rescheduling" OnDismiss="CancelReschedule">
        <ChildContent>
            <div class="pd-field">
                <label for="rescheduleDate" class="pd-label">Game date</label>
                <input id="rescheduleDate" type="date" class="pd-input" @bind="_rescheduleGameDate" />
            </div>
            <div class="pd-field">
                <label for="rescheduleDeadline" class="pd-label">Picks close</label>
                <input id="rescheduleDeadline" type="datetime-local" class="pd-input" @bind="_rescheduleDeadline" />
            </div>
            @if (_rescheduleError is not null)
            {
                <p class="pd-error-msg" role="alert"><Icon Name="alert" Size="18" />@_rescheduleError</p>
            }
        </ChildContent>
        <FooterContent>
            <button type="button" class="pd-btn pd-btn-quiet" @onclick="CancelReschedule">Cancel</button>
            <button type="button" class="pd-btn pd-btn-primary" disabled="@_reschedulingSaving" @onclick="SaveRescheduleAsync">
                @(_reschedulingSaving ? "Saving…" : "Save")
            </button>
        </FooterContent>
    </Modal>

    @* Always rendered, so screen readers announce additions and deletions *@
    <div role="status">
        @if (_statusMessage is not null)
        {
            <div class="pd-alert pd-alert-success edit-message">
                <Icon Name="check" />
                <p>@_statusMessage</p>
            </div>
        }
    </div>

    @if (_error is not null)
    {
        <div class="pd-alert pd-alert-danger edit-message" role="alert">
            <Icon Name="alert" />
            <p>@_error</p>
        </div>
    }

    <div class="edit-layout">
        <section aria-labelledby="questions-title">
            <h2 id="questions-title" class="pd-h2 edit-section-title" tabindex="-1" @ref="_questionsHeading">Questions (@Questions.Count)</h2>

            @if (Questions.Count == 0)
            {
                <p class="pd-card pd-muted edit-empty">No questions yet. Add one with “Add a question”.</p>
            }
            else
            {
                <ol class="pd-list-reset edit-questions">
                    @foreach (var (question, index) in Questions.Select((q, i) => (q, i)))
                    {
                        <li class="pd-card edit-question">
                            <span class="pd-display edit-question-num" aria-hidden="true">@(index + 1)</span>
                            <div class="edit-question-body">
                                <h3 class="pd-h3 edit-question-text"><span class="pd-sr-only">Question @(index + 1): </span>@question.Text</h3>
                                <ul class="pd-list-reset edit-options" aria-label="Options">
                                    @foreach (var option in question.Options.OrderBy(o => o.SortOrder))
                                    {
                                        <li class="edit-option">@option.Text</li>
                                    }
                                </ul>
                            </div>
                            @if (CanEditQuestions)
                            {
                                <button type="button" class="pd-btn pd-btn-danger pd-btn-sm" disabled="@Busy"
                                        @onclick="() => DeleteQuestionAsync(question)"><Icon Name="trash" Size="18" />Delete<span class="pd-sr-only"> question @(index + 1)</span></button>
                            }
                        </li>
                    }
                </ol>
            }
        </section>

        <div class="edit-side">
            @* Whatever state the poll is in, this is its next step - publishing, closing voting or
               scoring - so the poll is managed from here rather than back on Manage polls. *@
            <section class="pd-card edit-next" aria-labelledby="next-step-title">
                <h2 id="next-step-title" class="pd-h2 edit-section-title" tabindex="-1" @ref="_nextStepHeading">@NextStepTitle</h2>

                @if (_poll.Status == "Draft")
                {
                    <div class="edit-next-actions">
                        <button type="button" class="pd-btn pd-btn-primary pd-btn-lg pd-btn-block" disabled="@Busy"
                                @onclick="PublishAsync">
                            @(_publishing ? "Publishing…" : "Publish poll")
                        </button>
                    </div>
                    <p class="pd-hint edit-next-hint">You'll be asked to confirm first. Picks open straight away and close @_poll.Deadline.ToString("ddd d MMM, HH:mm").</p>
                }
                else if (_poll.Status == "Open")
                {
                    <div class="edit-next-actions">
                        <button type="button" class="pd-btn pd-btn-secondary pd-btn-lg pd-btn-block" disabled="@Busy"
                                @onclick="CloseVotingAsync">
                            <Icon Name="lock" />@(_closing ? "Closing…" : "Close voting")
                        </button>
                        <a href="poll/@PollId" class="pd-btn pd-btn-quiet pd-btn-block">View the live poll</a>
                    </div>
                    <p class="pd-hint edit-next-hint">Friends can pick until @_poll.Deadline.ToString("ddd d MMM, HH:mm"). Closing stops new picks and locks the questions — it can't be undone.</p>
                }
                else if (_poll.Status == "Closed")
                {
                    <div class="edit-next-actions">
                        <a href="admin/polls/@PollId/score" class="pd-btn pd-btn-primary pd-btn-lg pd-btn-block">Score poll</a>
                    </div>
                    <p class="pd-hint edit-next-hint">Set the correct answer for each question to mark everyone's picks and update the leaderboard.</p>
                }
                else
                {
                    <div class="edit-next-actions">
                        <a href="results/@PollId" class="pd-btn pd-btn-secondary pd-btn-lg pd-btn-block">View results</a>
                    </div>
                    <p class="pd-hint edit-next-hint">This poll is scored. Its questions can't be changed.</p>
                }
            </section>

            @* Questions are only editable while Draft or Open - the API rejects the rest. *@
            @if (CanEditQuestions)
            {
                <section class="pd-card edit-add" aria-labelledby="add-question-title">
                    <h2 id="add-question-title" class="pd-h2 edit-section-title">Add a question</h2>

                    <div class="edit-add-fields">
                        <div class="pd-field">
                            <label for="new-question" class="pd-label">Question</label>
                            @if (_questionError is not null)
                            {
                                <p id="new-question-error" class="pd-error-msg"><Icon Name="alert" Size="18" />@_questionError</p>
                            }
                            <input id="new-question" type="text" class="pd-input" @bind="_newQuestionText" @ref="_questionInput"
                                   aria-invalid="@(_questionError is null ? null : "true")"
                                   aria-describedby="@(_questionError is null ? null : "new-question-error")" />
                        </div>

                        <fieldset class="edit-options-fieldset"
                                  aria-describedby="@(_optionsError is null ? "options-hint" : "options-hint options-error")">
                            <legend class="pd-label">Options</legend>
                            <p id="options-hint" class="pd-hint">At least 2. Friends pick one.</p>
                            @if (_optionsError is not null)
                            {
                                <p id="options-error" class="pd-error-msg"><Icon Name="alert" Size="18" />@_optionsError</p>
                            }

                            @for (var i = 0; i < _newOptions.Count; i++)
                            {
                                var index = i;
                                <div class="edit-option-row">
                                    <label for="new-option-@index" class="pd-sr-only">Option @(index + 1)</label>
                                    <span class="pd-muted pd-strong pd-tnum edit-option-num" aria-hidden="true">@(index + 1)</span>
                                    <input id="new-option-@index" type="text" class="pd-input"
                                           value="@_newOptions[index]"
                                           @onchange="e => _newOptions[index] = e.Value?.ToString() ?? string.Empty"
                                           @ref="_optionInputs[index]"
                                           aria-invalid="@(_optionsError is not null && string.IsNullOrWhiteSpace(_newOptions[index]) ? "true" : null)" />
                                    @if (index >= 2)
                                    {
                                        <button type="button" class="pd-btn pd-btn-quiet pd-btn-icon" aria-label="Remove option @(index + 1)"
                                                @onclick="() => _newOptions.RemoveAt(index)"><Icon Name="x" /></button>
                                    }
                                    else
                                    {
                                        <span class="edit-option-spacer" aria-hidden="true"></span>
                                    }
                                </div>
                            }

                            <div>
                                <button type="button" class="pd-btn pd-btn-quiet pd-btn-sm edit-add-option" @onclick="() => _newOptions.Add(string.Empty)">
                                    <Icon Name="plus" Size="18" />Add option
                                </button>
                            </div>
                        </fieldset>

                        <button type="button" class="pd-btn pd-btn-primary edit-add-submit" disabled="@Busy" @onclick="AddQuestionAsync">
                            @(_addingQuestion ? "Adding…" : "Add question")
                        </button>
                    </div>
                </section>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string PollId { get; set; } = "";

    private PollDetailModel? _poll;
    private bool _loading = true;
    private bool _addingQuestion;
    private bool _deleting;
    private bool _publishing;
    private bool _closing;
    private bool _rescheduling;
    private bool _reschedulingSaving;
    private string? _loadError;
    private string? _error;
    private string? _statusMessage;
    private string? _questionError;
    private string? _optionsError;
    private string? _rescheduleError;

    private DateOnly _rescheduleGameDate;
    private DateTime _rescheduleDeadline;

    private string _newQuestionText = "";
    private List<string> _newOptions = ["", ""];

    private ElementReference _questionsHeading;
    private ElementReference _nextStepHeading;
    private ElementReference _questionInput;
    private readonly Dictionary<int, ElementReference> _optionInputs = new();

    private bool Busy => _addingQuestion || _deleting || _publishing || _closing || _reschedulingSaving;

    // The API rejects question edits once voting has closed
    private bool CanEditQuestions => _poll?.Status is "Draft" or "Open";

    private string NextStepTitle => _poll?.Status switch
    {
        "Draft" => "Ready to publish?",
        "Open" => "Open for picks",
        "Closed" => "Voting closed",
        _ => "Poll scored"
    };

    private List<QuestionModel> Questions =>
        _poll?.Questions.OrderBy(q => q.SortOrder).ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        await LoadPollAsync();
    }

    private async Task LoadPollAsync()
    {
        _loading = true;
        try
        {
            _poll = await Api.GetPollAsync(PollId);
        }
        catch (Exception)
        {
            if (_poll is null)
                _loadError = "Unable to load poll. Please try again later.";
            else
                _error = "Unable to refresh the poll. Please reload the page.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddQuestionAsync()
    {
        if (Busy) return;

        _statusMessage = null;
        _error = null;

        var questionText = _newQuestionText.Trim();
        var options = _newOptions
            .Where(o => !string.IsNullOrWhiteSpace(o))
            .Select((text, i) => new CreateOptionRequest(text.Trim(), i + 1))
            .ToList();

        _questionError = questionText.Length == 0 ? "Enter the question" : null;
        _optionsError = options.Count < 2 ? "Enter at least 2 options" : null;

        // Errors are shown next to each field; focus goes to the first one to fix.
        if (_questionError is not null)
        {
            await _questionInput.FocusAsync();
            return;
        }

        if (_optionsError is not null)
        {
            var firstBlank = Math.Max(_newOptions.FindIndex(string.IsNullOrWhiteSpace), 0);
            if (_optionInputs.TryGetValue(firstBlank, out var optionInput))
                await optionInput.FocusAsync();
            return;
        }

        _addingQuestion = true;

        try
        {
            var sortOrder = (_poll?.Questions.Count ?? 0) + 1;
            await Api.AddQuestionAsync(PollId, new CreateQuestionRequest(questionText, sortOrder, options));

            _newQuestionText = "";
            _newOptions = ["", ""];

            await LoadPollAsync();
            _statusMessage = $"Added “{questionText}”.";

            // Ready for the next question
            await _questionInput.FocusAsync();
        }
        catch (Exception)
        {
            _error = "Failed to add question. Please try again.";
        }
        finally
        {
            _addingQuestion = false;
        }
    }

    private async Task PublishAsync()
    {
        if (Busy || _poll is null) return;

        _statusMessage = null;
        _error = null;

        // Publish stays enabled with nothing to answer yet, and says what's missing instead - a
        // disabled button leaves the tab order and announces nothing. The API enforces it too.
        if (Questions.Count == 0)
        {
            _error = "Add a question before publishing.";
            await _questionInput.FocusAsync();
            return;
        }

        // Same confirmation as Manage polls, so publishing reads the same wherever you do it from
        if (!await ConfirmDialog.ShowAsync(
                $"\"{_poll.Title}\" will open for voting immediately.",
                title: "Publish this poll?",
                confirmLabel: "Publish"))
            return;

        _publishing = true;

        try
        {
            var updated = await Api.PublishPollAsync(PollId);

            // Publishing doesn't touch the questions, so patch the status rather than reloading:
            // a failed refresh would show an error over a publish that worked.
            _poll = _poll with { Status = updated?.Status ?? "Open" };
            _statusMessage = $"“{_poll.Title}” is now open for picks.";

            // The Publish button is gone - the panel heading names the state that replaced it
            await _nextStepHeading.FocusAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            _error = ex.Body.Contains("no questions", StringComparison.OrdinalIgnoreCase)
                ? "Add a question before publishing."
                : "This poll can no longer be published. Reload the page to see its current status.";
        }
        catch (Exception)
        {
            _error = "Failed to publish poll. Please try again.";
        }
        finally
        {
            _publishing = false;
        }
    }

    private void OpenReschedule()
    {
        if (_poll is null) return;

        _rescheduleGameDate = _poll.GameDate;
        _rescheduleDeadline = _poll.Deadline;
        _rescheduleError = null;
        _rescheduling = true;
    }

    private void CancelReschedule()
    {
        _rescheduling = false;
        _rescheduleError = null;
    }

    private async Task SaveRescheduleAsync()
    {
        if (_reschedulingSaving || _poll is null) return;

        _rescheduleError = null;
        _reschedulingSaving = true;

        try
        {
            var updated = await Api.ReschedulePollAsync(
                PollId, new RescheduleRequest(_rescheduleGameDate, _rescheduleDeadline));

            _poll = _poll with
            {
                GameDate = updated?.GameDate ?? _rescheduleGameDate,
                Deadline = updated?.Deadline ?? _rescheduleDeadline
            };
            _statusMessage = "Date and time updated.";
            _rescheduling = false;
        }
        catch (ApiException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            // Shown inside the still-open modal, not the page-level _error - the admin is mid-edit.
            _rescheduleError = ex.ApiMessage ?? "That date and time couldn't be saved. Please try again.";
        }
        catch (Exception)
        {
            _rescheduleError = "Failed to save. Please try again.";
        }
        finally
        {
            _reschedulingSaving = false;
        }
    }

    private async Task CloseVotingAsync()
    {
        if (Busy || _poll is null) return;

        _statusMessage = null;
        _error = null;

        if (!await ConfirmDialog.ShowAsync(
                $"Voting for \"{_poll.Title}\" will close. This cannot be undone.",
                title: "Close voting?",
                confirmLabel: "Close voting",
                danger: true))
            return;

        _closing = true;

        try
        {
            var updated = await Api.ClosePollAsync(PollId);
            _poll = _poll with { Status = updated?.Status ?? "Closed" };
            _statusMessage = $"Voting is closed for “{_poll.Title}”.";

            await _nextStepHeading.FocusAsync();
        }
        catch (Exception)
        {
            _error = "Failed to close poll. Please try again.";
        }
        finally
        {
            _closing = false;
        }
    }

    private async Task DeleteQuestionAsync(QuestionModel question)
    {
        if (Busy) return;

        _statusMessage = null;
        _error = null;
        _deleting = true;

        try
        {
            await Api.DeleteQuestionAsync(PollId, question.QuestionId);
            await LoadPollAsync();
            _statusMessage = $"Deleted “{question.Text}”.";

            // The Delete button that had focus is gone - move focus somewhere sensible
            await _questionsHeading.FocusAsync();
        }
        catch (Exception)
        {
            _error = "Failed to delete question. Please try again.";
        }
        finally
        {
            _deleting = false;
        }
    }
}
