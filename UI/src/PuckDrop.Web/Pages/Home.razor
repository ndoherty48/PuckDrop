@page "/"
@attribute [Authorize]

@inject PuckDropApiClient Api

<div class="container-fluid">
    <h1 class="mb-4">🏒 PuckDrop</h1>

    @if (loading)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-warning" role="alert">
                @errorMessage
            </div>
        }

        <div class="row g-4">
            @* ─── Next Game Card ─────────────────────────────────────────── *@
            <div class="col-12 col-md-6">
                <div class="card h-100">
                    <div class="card-header">
                        <h5 class="mb-0">🎯 Next Game</h5>
                    </div>
                    <div class="card-body d-flex flex-column">
                        @if (activePoll is not null)
                        {
                            <h5 class="card-title">@activePoll.Title</h5>
                            <p class="card-text text-muted">
                                Deadline: @activePoll.Deadline.ToString("g")
                            </p>
                            <p>
                                @if (hasPicked)
                                {
                                    <span class="badge bg-success">✓ Picks submitted</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Picks not yet in</span>
                                }
                            </p>
                            <a href="poll/@activePoll.PollId" class="btn btn-primary mt-auto">
                                @(hasPicked ? "Update your picks" : "Make your picks")
                            </a>
                        }
                        else
                        {
                            <p class="card-text text-muted">No upcoming poll</p>
                        }
                    </div>
                </div>
            </div>

            @* ─── Quick Leaderboard ──────────────────────────────────────── *@
            <div class="col-12 col-md-6">
                <div class="card h-100">
                    <div class="card-header">
                        <h5 class="mb-0">🏆 Quick Leaderboard</h5>
                    </div>
                    <div class="card-body">
                        @if (topEntries is not null && topEntries.Count > 0)
                        {
                            <ol class="list-group list-group-numbered">
                                @foreach (var entry in topEntries)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        @entry.DisplayName
                                        <span class="badge bg-primary rounded-pill">@entry.TotalPoints pts</span>
                                    </li>
                                }
                            </ol>
                        }
                        else
                        {
                            <p class="card-text text-muted">No leaderboard data yet</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private PollModel? activePoll;
    private List<LeaderboardEntryModel>? topEntries;
    private bool hasPicked;
    private bool loading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var season = await Api.GetCurrentSeasonAsync();

            if (season is not null)
            {
                var activePolls = await Api.GetActivePollsAsync(season.SeasonId);
                activePoll = activePolls?.FirstOrDefault();

                if (activePoll is not null)
                {
                    var existingAnswers = await Api.GetAnswersAsync(activePoll.PollId);
                    hasPicked = existingAnswers is { Count: > 0 };
                }

                var leaderboard = await Api.GetLeaderboardAsync(season.SeasonId);
                topEntries = leaderboard?.Entries?.OrderBy(e => e.Rank).Take(5).ToList();
            }
        }
        catch (Exception)
        {
            errorMessage = "Unable to load dashboard data. Please try again later.";
        }
        finally
        {
            loading = false;
        }
    }
}
