@page "/"
@attribute [Authorize]

@inject PuckDropApiClient Api
@inject AuthenticationStateProvider AuthStateProvider

<div class="pd-page-head">
    <div>
        @if (seasonName is not null)
        {
            <p class="pd-eyebrow home-eyebrow">@seasonName</p>
        }
        <h1 class="pd-page-title">Game day</h1>
    </div>
</div>

@if (loading)
{
    <p class="pd-muted" role="status">Loading game day…</p>
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="pd-alert pd-alert-warning home-alert" role="alert">
            <Icon Name="alert" />
            <p>@errorMessage</p>
        </div>
    }

    <div class="home-grid">
        @* ─── Next game ─────────────────────────────────────────────────── *@
        <section class="pd-card home-next" aria-labelledby="next-game-title">
            @if (activePoll is not null)
            {
                <div class="home-hero pd-on-dark">
                    <svg class="home-rink" viewBox="0 0 340 340" aria-hidden="true" focusable="false">
                        <circle cx="170" cy="170" r="140" fill="none" stroke="#1D3E66" stroke-width="4" />
                        <circle cx="170" cy="170" r="90" fill="none" stroke="#1D3E66" stroke-width="2" />
                        <circle cx="170" cy="170" r="9" fill="#DE3C37" />
                        <path d="M150 170h-40M190 170h40M170 150v-40M170 190v40" stroke="#1D3E66" stroke-width="2" />
                    </svg>
                    <p class="pd-eyebrow home-hero-eyebrow">Next game · @activePoll.GameDate.ToString("dddd d MMMM")</p>
                    <h2 id="next-game-title" class="pd-display home-hero-title">@activePoll.Title</h2>
                </div>

                <div class="home-next-body">
                    <dl class="home-facts">
                        <div>
                            <dt class="pd-eyebrow">Picks close</dt>
                            <dd class="pd-meta home-fact-value">
                                <Icon Name="clock" />
                                <span>@activePoll.Deadline.ToString("ddd d MMM, HH:mm")</span>
                            </dd>
                            <dd class="pd-muted home-fact-sub">@DisplayText.TimeUntilDeadline(activePoll.Deadline, DateTime.UtcNow)</dd>
                        </div>
                        <div>
                            <dt class="pd-eyebrow">Your picks</dt>
                            <dd class="home-fact-value">
                                @if (hasPicked)
                                {
                                    <span class="pd-badge pd-badge-open"><Icon Name="check" Size="16" />Picks submitted</span>
                                }
                                else
                                {
                                    <span class="pd-badge pd-badge-pending"><Icon Name="alert" Size="16" />Not in yet</span>
                                }
                            </dd>
                        </div>
                    </dl>

                    <a href="poll/@activePoll.PollId" class="pd-btn pd-btn-primary pd-btn-lg home-cta">
                        @(hasPicked ? "Update your picks" : "Make your picks")
                        <Icon Name="right" />
                    </a>
                </div>
            }
            else
            {
                <div class="home-next-body">
                    <h2 id="next-game-title" class="pd-h2">Next game</h2>
                    <p class="pd-muted home-empty-text">No upcoming poll</p>
                </div>
            }
        </section>

        @* ─── Quick leaderboard ─────────────────────────────────────────── *@
        <section class="pd-card" aria-labelledby="quick-leaderboard-title">
            <div class="pd-card-head">
                <h2 id="quick-leaderboard-title" class="pd-h2">Leaderboard</h2>
                <a href="leaderboard" class="home-card-link">Full standings</a>
            </div>

            @if (topEntries is { Count: > 0 })
            {
                <ol class="pd-rank-list">
                    @foreach (var entry in topEntries)
                    {
                        var isYou = entry.UserId == currentUserId;
                        <li class="pd-rank-row @(isYou ? "pd-row-you" : null)">
                            <span class="pd-rank"><span class="pd-sr-only">Rank </span>@entry.Rank</span>
                            <span class="home-rank-name">
                                @entry.DisplayName
                                @if (isYou)
                                {
                                    <span class="pd-badge pd-badge-you">You</span>
                                }
                            </span>
                            <span class="home-rank-points pd-tnum">@entry.TotalPoints <span class="pd-muted">pts</span></span>
                        </li>
                    }
                </ol>
            }
            else
            {
                <p class="pd-muted home-empty">No leaderboard data yet</p>
            }
        </section>
    </div>
}

@code {
    private PollModel? activePoll;
    private List<LeaderboardEntryModel>? topEntries;
    private bool hasPicked;
    private bool loading = true;
    private string? errorMessage;
    private string? seasonName;
    private string? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Raw "sub" claim, not ClaimTypes.NameIdentifier - same reason as Leaderboard.razor.
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            currentUserId = authState.User.FindFirst("sub")?.Value;

            var season = await Api.GetCurrentSeasonAsync();

            if (season is not null)
            {
                seasonName = season.Name;

                var activePolls = await Api.GetActivePollsAsync(season.SeasonId);
                activePoll = activePolls?.FirstOrDefault();

                if (activePoll is not null)
                {
                    var existingAnswers = await Api.GetAnswersAsync(activePoll.PollId);
                    hasPicked = existingAnswers is { Count: > 0 };
                }

                var leaderboard = await Api.GetLeaderboardAsync(season.SeasonId);
                topEntries = leaderboard?.Entries?.OrderBy(e => e.Rank).Take(5).ToList();
            }
        }
        catch (Exception)
        {
            errorMessage = "Unable to load dashboard data. Please try again later.";
        }
        finally
        {
            loading = false;
        }
    }
}
