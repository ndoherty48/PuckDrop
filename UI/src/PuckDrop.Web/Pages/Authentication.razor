@page "/authentication/{action}"
@attribute [AllowAnonymous]

@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

<RemoteAuthenticatorView Action="@Action">
    <LoggingIn>
        <p class="pd-muted" role="status">Checking login state…</p>
    </LoggingIn>
    <CompletingLoggingIn>
        <p class="pd-muted" role="status">Completing login…</p>
    </CompletingLoggingIn>
    <LogInFailed>
        <StatusScreen IconName="alert" Title="We couldn't log you in">
            <ChildContent>
                <p>Please try again.</p>
            </ChildContent>
            <Actions>
                <a href="authentication/login" class="pd-btn pd-btn-primary">Try again</a>
                <a href="" class="pd-btn pd-btn-quiet">Back to home</a>
            </Actions>
        </StatusScreen>
    </LogInFailed>
    <LogOut>
        <p class="pd-muted" role="status">Logging out…</p>
    </LogOut>
    <CompletingLogOut>
        <p class="pd-muted" role="status">Completing logout…</p>
    </CompletingLogOut>
    <LogOutSucceeded>
        <StatusScreen IconName="logout" Title="Logged out">
            <ChildContent>
                <p>You've been logged out. Log back in any time to make your picks.</p>
            </ChildContent>
            <Actions>
                <a href="authentication/login" class="pd-btn pd-btn-primary">Log back in</a>
            </Actions>
        </StatusScreen>
    </LogOutSucceeded>
    <LogOutFailed>
        <StatusScreen IconName="alert" Title="We couldn't log you out cleanly">
            <ChildContent>
                <p>Your session may still have been cleared on this device.</p>
            </ChildContent>
            <Actions>
                <a href="" class="pd-btn pd-btn-primary">Back to home</a>
            </Actions>
        </StatusScreen>
    </LogOutFailed>
    <Registering>
        <StatusScreen IconName="info" Title="Registration isn't available">
            <ChildContent>
                <p>Contact an admin for access.</p>
            </ChildContent>
            <Actions>
                <a href="" class="pd-btn pd-btn-primary">Back to home</a>
            </Actions>
        </StatusScreen>
    </Registering>
    <UserProfile>
        <StatusScreen IconName="info" Title="Profile editing isn't available">
            <ChildContent>
                <p>Your name comes from your login account.</p>
            </ChildContent>
            <Actions>
                <a href="" class="pd-btn pd-btn-primary">Back to home</a>
            </Actions>
        </StatusScreen>
    </UserProfile>
</RemoteAuthenticatorView>

@code {
    [Parameter]
    public string? Action { get; set; }
}
