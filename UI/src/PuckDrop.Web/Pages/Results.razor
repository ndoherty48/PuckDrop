@page "/results/{PollId}"
@attribute [Authorize]
@inject PuckDropApiClient Api

<h2>Poll Results</h2>

@if (_loading)
{
    <p><em>Loading results...</em></p>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_results is not null)
{
    <div class="card mb-4">
        <div class="card-header">
            <h4 class="mb-0">@_poll?.Title</h4>
        </div>
        <div class="card-body">
            @* One row per user, one column per question - keeps the table growing
               vertically as the friend group grows, instead of gaining a new column
               per user (which is the axis that's actually unbounded). *@
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle">
                    <thead>
                        <tr>
                            <th>User</th>
                            @foreach (var question in _results.Questions)
                            {
                                var correctOption = question.Options.FirstOrDefault(o => o.OptionId == question.CorrectOptionId);
                                <th>
                                    @question.Text
                                    <div class="fw-normal small text-success mt-1">
                                        Correct: @(correctOption?.Text ?? "—")
                                    </div>
                                </th>
                            }
                            <th>Points</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in _results.UserResults.OrderByDescending(u => u.Points))
                        {
                            <tr>
                                <td>@user.DisplayName</td>
                                @foreach (var question in _results.Questions)
                                {
                                    var answer = user.Answers.FirstOrDefault(a => a.QuestionId == question.QuestionId);
                                    var selectedOption = question.Options.FirstOrDefault(o => o.OptionId == answer?.SelectedOptionId);
                                    <td class="@(answer?.IsCorrect switch { true => "table-success", false => "table-danger", null => "" })">
                                        @if (selectedOption is not null)
                                        {
                                            @selectedOption.Text
                                            <span class="fw-bold ms-1">@(answer!.IsCorrect == true ? "✓" : "✗")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                }
                                <td class="fw-bold">@user.Points</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string PollId { get; set; } = default!;

    private PollResultsModel? _results;
    private PollDetailModel? _poll;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _poll = await Api.GetPollAsync(PollId);
            _results = await Api.GetResultsAsync(PollId);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load results: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
