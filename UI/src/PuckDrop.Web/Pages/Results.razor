@page "/results/{PollId}"
@attribute [Authorize]
@inject PuckDropApiClient Api
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@using System.Net

@if (_loading)
{
    <p class="pd-muted" role="status">Loading results…</p>
}
else if (_error is not null || _results is null)
{
    <a class="pd-back-link" href="history"><Icon Name="left" />Back to history</a>
    <h1 class="pd-page-title results-error-title">Poll Results</h1>

    @if (_error is not null)
    {
        <div class="pd-alert pd-alert-danger" role="alert">
            <Icon Name="alert" />
            <p>@_error</p>
        </div>
    }
    else
    {
        <p class="pd-card pd-muted results-empty">Results aren't available for this poll yet.</p>
    }
}
else
{
    <div class="results-head">
        <a class="pd-back-link" href="history"><Icon Name="left" />Back to history</a>
        <p class="pd-eyebrow results-eyebrow">Poll results@(_poll is not null ? $" · {_poll.GameDate:ddd d MMM yyyy}" : "")</p>
        <h1 class="pd-page-title">@(_poll?.Title ?? "Poll Results")</h1>
        <div class="pd-meta-row">
            @if (_results.Status == "Scored")
            {
                <span class="pd-badge pd-badge-scored"><Icon Name="check" Size="16" />Scored</span>
            }
            @if (YourResult is { } you)
            {
                <span class="pd-strong">You scored @you.Points of @_questions.Count</span>
            }
        </div>
    </div>

    @* ─── Desktop: one row per player, one column per question ──────────────
       Grows downwards as the group grows, rather than gaining a column per player
       (the axis that's actually unbounded). *@
    <section class="pd-card results-table-card" aria-labelledby="results-picks-title">
        <div class="pd-card-head results-card-head">
            <h2 id="results-picks-title" class="pd-h2">Everyone's picks</h2>
            <div class="results-legend" aria-hidden="true">
                <span class="pd-pick"><span class="pd-mark pd-mark-correct"><Icon Name="check" Size="16" /></span>Correct</span>
                <span class="pd-pick"><span class="pd-mark pd-mark-wrong"><Icon Name="x" Size="16" /></span>Wrong</span>
                <span class="pd-muted">— No pick</span>
            </div>
        </div>

        <div class="pd-table-wrap">
            <table class="pd-table results-table">
                <caption class="pd-sr-only">Each player's pick for every question, whether it was correct, and their points for this game</caption>
                <thead>
                    <tr>
                        <th scope="col" class="results-player-col">Player</th>
                        @foreach (var (question, index) in _questions.Select((q, i) => (q, i)))
                        {
                            <th scope="col" class="pd-th-plain">
                                <span class="pd-eyebrow results-q-num">Q@(index + 1)</span>
                                <span class="results-q-text">@question.Text</span>
                                <span class="results-answer"><Icon Name="check" Size="16" />Answer: @CorrectAnswerText(question)</span>
                            </th>
                        }
                        <th scope="col" class="pd-num">Points</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in RankedUsers)
                    {
                        <tr class="@(IsYou(user) ? "pd-row-you" : null)">
                            <th scope="row">@PlayerName(user)</th>
                            @foreach (var question in _questions)
                            {
                                var answer = AnswerFor(user, question);
                                var option = SelectedOption(answer, question);

                                if (answer is null || option is null)
                                {
                                    <td><span class="pd-muted" aria-hidden="true">—</span><span class="pd-sr-only">No pick</span></td>
                                }
                                else if (answer.IsCorrect == true)
                                {
                                    <td class="pd-cell-correct">
                                        <span class="pd-pick"><span class="pd-mark pd-mark-correct"><Icon Name="check" Size="16" /></span>@option.Text<span class="pd-sr-only">, correct</span></span>
                                    </td>
                                }
                                else if (answer.IsCorrect == false)
                                {
                                    <td class="pd-cell-wrong">
                                        <span class="pd-pick"><span class="pd-mark pd-mark-wrong"><Icon Name="x" Size="16" /></span>@option.Text<span class="pd-sr-only">, wrong</span></span>
                                    </td>
                                }
                                else
                                {
                                    <td>@option.Text</td>
                                }
                            }
                            <td class="pd-num pd-display results-points">@user.Points</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @* ─── Phones: points first, then one expandable section per question ──── *@
    <div class="results-mobile">
        <section class="pd-card" aria-labelledby="results-points-title">
            <div class="pd-card-head">
                <h2 id="results-points-title" class="pd-h2 results-mobile-h2">Points this game</h2>
            </div>
            <ol class="pd-list-reset results-points-list">
                @foreach (var user in RankedUsers)
                {
                    <li class="results-points-row @(IsYou(user) ? "pd-row-you" : null)">
                        @PlayerName(user)
                        <span class="pd-strong pd-tnum">@user.Points <span class="pd-muted results-pts">@(user.Points == 1 ? "pt" : "pts")</span></span>
                    </li>
                }
            </ol>
        </section>

        <h2 class="pd-h2 results-mobile-h2 results-by-question">Question by question</h2>

        <div class="results-questions">
            @foreach (var (question, index) in _questions.Select((q, i) => (q, i)))
            {
                var expanded = _expandedQuestions.Contains(question.QuestionId);
                var panelId = $"results-q-{question.QuestionId}";

                <section class="pd-card">
                    <h3 class="results-disclosure-heading">
                        <button type="button" class="pd-disclosure"
                                aria-expanded="@(expanded ? "true" : "false")"
                                aria-controls="@(expanded ? panelId : null)"
                                @onclick="() => ToggleQuestion(question.QuestionId)">
                            <span class="results-disclosure-text">
                                <span class="pd-q-num">Question @(index + 1)</span>
                                <span class="results-disclosure-q">@question.Text</span>
                                <span class="results-answer"><Icon Name="check" Size="16" />Answer: @CorrectAnswerText(question)</span>
                                <span class="pd-muted results-right-count">@RightCount(question) of @AnsweredCount(question) got it right</span>
                            </span>
                            <Icon Name="down" Size="24" />
                        </button>
                    </h3>

                    @if (expanded)
                    {
                        <ul id="@panelId" class="pd-list-reset results-picks">
                            @foreach (var user in RankedUsers)
                            {
                                var answer = AnswerFor(user, question);
                                var option = SelectedOption(answer, question);

                                <li class="results-pick-row">
                                    @PlayerName(user)
                                    @if (answer is null || option is null)
                                    {
                                        <span class="pd-muted">No pick</span>
                                    }
                                    else if (answer.IsCorrect is { } isCorrect)
                                    {
                                        <span class="pd-pick results-pick">@option.Text<span class="pd-mark @(isCorrect ? "pd-mark-correct" : "pd-mark-wrong")"><Icon Name="@(isCorrect ? "check" : "x")" Size="16" /></span><span class="pd-sr-only">@(isCorrect ? "correct" : "wrong")</span></span>
                                    }
                                    else
                                    {
                                        <span class="results-pick">@option.Text</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </section>
            }
        </div>
    </div>

    @* ─── Admin: void or restore a player's picks ────────────────────────────
       A void takes this game day off the player's season total. It is reversible: restoring
       puts the points back exactly, because season totals are folded from facts rather than
       accumulated. *@
    <AuthorizeView Roles="admin">
        <section class="pd-card results-admin" aria-labelledby="results-admin-title">
            <div class="pd-card-head">
                <h2 id="results-admin-title" class="pd-h2" tabindex="-1" @ref="_adminHeading">Void picks</h2>
            </div>

            <p class="pd-muted results-admin-intro">
                Voiding takes this game day's points and answered count off a player's season total.
                The reason is shown to everyone on the leaderboard, and you can restore the picks at
                any time.
            </p>

            <div role="status" aria-live="polite">
                @if (_adminStatus is not null)
                {
                    <div class="pd-alert pd-alert-success">
                        <Icon Name="check" />
                        <p>@_adminStatus</p>
                    </div>
                }
            </div>

            @if (_adminError is not null)
            {
                <div class="pd-alert pd-alert-danger" role="alert">
                    <Icon Name="alert" />
                    <p>@_adminError</p>
                </div>
            }

            <ul class="pd-list-reset results-void-list">
                @foreach (var user in RankedUsers)
                {
                    <li class="results-void-row">
                        <span class="results-player">@user.DisplayName</span>

                        @if (user.IsVoided)
                        {
                            <span class="pd-muted results-void-reason">Voided · @user.VoidReason</span>
                            <button type="button" class="pd-btn pd-btn-secondary pd-btn-sm" disabled="@Busy"
                                    @onclick="() => RestorePicksAsync(user)">
                                Restore picks<span class="pd-sr-only"> for @user.DisplayName</span>
                            </button>
                        }
                        else if (_voidingUserId == user.UserId)
                        {
                            <div class="pd-field results-void-form">
                                <label class="pd-label" for="void-reason">Reason</label>
                                <input id="void-reason" class="pd-input" @bind="_voidReason" @bind:event="oninput"
                                       aria-invalid="@(_reasonMissing ? "true" : null)"
                                       aria-describedby="@(_reasonMissing ? "void-reason-error" : null)" />
                                @if (_reasonMissing)
                                {
                                    <p id="void-reason-error" class="pd-error-msg" role="alert">
                                        Give a reason - everyone sees it on the leaderboard.
                                    </p>
                                }
                                <div class="pd-btn-row">
                                    <button type="button" class="pd-btn pd-btn-danger pd-btn-sm" disabled="@Busy"
                                            @onclick="() => ConfirmVoidAsync(user)">
                                        @(_voiding ? "Voiding…" : "Void picks")
                                    </button>
                                    <button type="button" class="pd-btn pd-btn-quiet pd-btn-sm" disabled="@Busy"
                                            @onclick="CancelVoid">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="pd-btn pd-btn-secondary pd-btn-sm" disabled="@Busy"
                                    @onclick="() => StartVoid(user)">
                                Void picks<span class="pd-sr-only"> for @user.DisplayName</span>
                            </button>
                        }
                    </li>
                }
            </ul>
        </section>
    </AuthorizeView>
}

@code {
    [Parameter] public string PollId { get; set; } = default!;

    private PollResultsModel? _results;
    private PollDetailModel? _poll;
    private List<QuestionModel> _questions = [];
    private readonly HashSet<string> _expandedQuestions = [];
    private bool _loading = true;
    private string? _error;
    private string? _currentUserId;

    // Admin void/restore
    private ElementReference _adminHeading;
    private string? _adminStatus;
    private string? _adminError;
    private string? _voidingUserId;
    private string _voidReason = string.Empty;
    private bool _reasonMissing;
    private bool _voiding;
    private bool _restoring;

    private bool Busy => _voiding || _restoring;

    private IEnumerable<UserResultModel> RankedUsers =>
        _results?.UserResults.OrderByDescending(u => u.Points).ThenBy(u => u.DisplayName)
        ?? Enumerable.Empty<UserResultModel>();

    private UserResultModel? YourResult =>
        _results?.UserResults.FirstOrDefault(IsYou);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Raw "sub" claim, not ClaimTypes.NameIdentifier - same reason as Leaderboard.razor.
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _currentUserId = authState.User.FindFirst("sub")?.Value;

            _poll = await Api.GetPollAsync(PollId);
            _results = await Api.GetResultsAsync(PollId);

            if (_results is not null)
            {
                _questions = _results.Questions.OrderBy(q => q.SortOrder).ToList();
                if (_questions.Count > 0)
                    _expandedQuestions.Add(_questions[0].QuestionId);
            }
        }
        catch (Exception)
        {
            _error = "Unable to load results. Please try again later.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleQuestion(string questionId)
    {
        if (!_expandedQuestions.Remove(questionId))
            _expandedQuestions.Add(questionId);
    }

    private bool IsYou(UserResultModel user) => user.UserId == _currentUserId;

    private static UserAnswerModel? AnswerFor(UserResultModel user, QuestionModel question) =>
        user.Answers.FirstOrDefault(a => a.QuestionId == question.QuestionId);

    private static OptionModel? SelectedOption(UserAnswerModel? answer, QuestionModel question) =>
        answer is null ? null : question.Options.FirstOrDefault(o => o.OptionId == answer.SelectedOptionId);

    private static string CorrectAnswerText(QuestionModel question) =>
        question.Options.FirstOrDefault(o => o.OptionId == question.CorrectOptionId)?.Text ?? "—";

    private int RightCount(QuestionModel question) =>
        _results?.UserResults.Count(u => AnswerFor(u, question)?.IsCorrect == true) ?? 0;

    private int AnsweredCount(QuestionModel question) =>
        _results?.UserResults.Count(u => AnswerFor(u, question) is not null) ?? 0;

    private RenderFragment PlayerName(UserResultModel user) =>
        @<span class="results-player">
            @user.DisplayName
            @if (IsYou(user))
            {
                <span class="pd-badge pd-badge-you">You</span>
            }
            @if (user.IsVoided)
            {
                @* Every surface below renders names through here, so one badge covers the desktop
                   table, the phone points list and each question panel. *@
                <span class="pd-badge pd-badge-voided" title="@user.VoidReason">Voided</span>
            }
        </span>;

    private void StartVoid(UserResultModel user)
    {
        _voidingUserId = user.UserId;
        _voidReason = string.Empty;
        _reasonMissing = false;
        _adminError = null;
        _adminStatus = null;
    }

    private void CancelVoid()
    {
        _voidingUserId = null;
        _voidReason = string.Empty;
        _reasonMissing = false;
    }

    private async Task ConfirmVoidAsync(UserResultModel user)
    {
        if (Busy) return;

        // Say what's missing rather than disabling the button, as elsewhere in the admin pages.
        if (string.IsNullOrWhiteSpace(_voidReason))
        {
            _reasonMissing = true;
            return;
        }

        _reasonMissing = false;
        _voiding = true;
        _adminError = null;
        _adminStatus = null;

        try
        {
            await Api.VoidPicksAsync(PollId, new VoidPicksRequest(user.UserId, _voidReason.Trim()));
            await ReloadResultsAsync();
            _adminStatus = $"{user.DisplayName}'s picks for this game day are voided.";
            _voidingUserId = null;
            _voidReason = string.Empty;
        }
        catch (ApiException ex)
        {
            _adminError = ex.ApiMessage
                ?? (ex.StatusCode == HttpStatusCode.NotFound
                    ? "That endpoint isn't available. The app may be running an older build - restart it to pick up the latest."
                    : $"The server rejected the void ({(int)ex.StatusCode}).");
        }
        catch (Exception)
        {
            _adminError = "Failed to void picks. Please try again.";
        }
        finally
        {
            _voiding = false;
        }

        // The button that was clicked is replaced by its opposite, so move focus somewhere stable.
        await _adminHeading.FocusAsync();
    }

    private async Task RestorePicksAsync(UserResultModel user)
    {
        if (Busy) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Restore {user.DisplayName}'s picks? This game day will count towards their season total again.");
        if (!confirmed) return;

        _restoring = true;
        _adminError = null;
        _adminStatus = null;

        try
        {
            await Api.RestorePicksAsync(PollId, user.UserId);
            await ReloadResultsAsync();
            _adminStatus = $"{user.DisplayName}'s picks count again.";
        }
        catch (ApiException ex)
        {
            _adminError = ex.ApiMessage
                ?? (ex.StatusCode == HttpStatusCode.NotFound
                    ? "Those picks aren't voided any more. Reload the page."
                    : $"The server rejected the restore ({(int)ex.StatusCode}).");
        }
        catch (Exception)
        {
            _adminError = "Failed to restore picks. Please try again.";
        }
        finally
        {
            _restoring = false;
        }

        await _adminHeading.FocusAsync();
    }

    /// <summary>
    /// Re-reads the results so the voided badges reflect what the API actually stored, rather than
    /// being patched in optimistically.
    /// </summary>
    private async Task ReloadResultsAsync()
    {
        _results = await Api.GetResultsAsync(PollId);
    }
}
