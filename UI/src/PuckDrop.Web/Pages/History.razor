@page "/history"
@attribute [Authorize]
@inject PuckDropApiClient Api

<div class="pd-page-head">
    <div>
        @if (_seasonName is not null)
        {
            <p class="pd-eyebrow history-eyebrow">@_seasonName</p>
        }
        <h1 class="pd-page-title">Poll history</h1>
    </div>
</div>

@if (_loading)
{
    <p class="pd-muted" role="status">Loading history…</p>
}
else if (_error is not null)
{
    <div class="pd-alert pd-alert-danger" role="alert">
        <Icon Name="alert" />
        <p>@_error</p>
    </div>
}
else if (_polls is not null)
{
    @if (!_polls.Any())
    {
        <p class="pd-card pd-muted history-empty">No past polls found.</p>
    }
    else
    {
        <section class="pd-card history-card" aria-label="Past game days">
            <ol class="pd-list-reset">
                @foreach (var poll in _polls)
                {
                    <li class="history-row">
                        <div class="history-date" aria-hidden="true">
                            <span class="pd-display history-day">@poll.GameDate.Day</span>
                            <span class="pd-eyebrow history-month">@poll.GameDate.ToString("MMM")</span>
                        </div>

                        <div class="history-main">
                            <h2 class="pd-h3 history-title">@poll.Title</h2>
                            <p class="pd-muted history-when">@poll.GameDate.ToString("ddd d MMM yyyy")</p>
                        </div>

                        <div class="history-status">
                            @if (poll.Status == "Scored")
                            {
                                <span class="pd-badge pd-badge-scored"><Icon Name="check" Size="16" />Scored</span>
                            }
                            else
                            {
                                <span class="pd-badge pd-badge-closed"><Icon Name="lock" Size="16" />Closed</span>
                            }
                        </div>

                        <div class="history-action">
                            @if (poll.Status == "Scored")
                            {
                                @* Hidden text keeps each "View results" link distinct out of context *@
                                <a href="results/@poll.PollId" class="pd-btn pd-btn-secondary pd-btn-sm">
                                    View results<span class="pd-sr-only"> for @poll.Title</span>
                                    <Icon Name="right" Size="18" />
                                </a>
                            }
                            else
                            {
                                <span class="pd-muted history-pending">Results after scoring</span>
                            }
                        </div>
                    </li>
                }
            </ol>
        </section>
    }
}

@code {
    private List<PollModel>? _polls;
    private bool _loading = true;
    private string? _error;
    private string? _seasonName;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var season = await Api.GetCurrentSeasonAsync();
            if (season is null)
            {
                _error = "No current season found.";
                return;
            }

            _seasonName = season.Name;

            var allPolls = await Api.GetPollsAsync(season.SeasonId);
            _polls = allPolls?
                .Where(p => p.Status is "Closed" or "Scored")
                .OrderByDescending(p => p.GameDate)
                .ToList() ?? [];
        }
        catch (Exception)
        {
            _error = "Unable to load history. Please try again later.";
        }
        finally
        {
            _loading = false;
        }
    }
}
