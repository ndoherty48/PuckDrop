@page "/leaderboard"
@attribute [Authorize]
@inject PuckDropApiClient Api
@inject AuthenticationStateProvider AuthStateProvider

<h2>Leaderboard</h2>

@if (_loading)
{
    <p><em>Loading leaderboard...</em></p>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_leaderboard is null || _leaderboard.Entries.Count == 0)
{
    <p class="text-muted">No leaderboard data yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Rank</th>
                <th>Name</th>
                <th>Points</th>
                <th>Games Played</th>
                <th>Accuracy %</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in _leaderboard.Entries.OrderBy(e => e.Rank))
            {
                var isYou = entry.UserId == _currentUserId;
                <tr class="@(isYou ? "table-primary" : "")">
                    <td>@entry.Rank</td>
                    <td>
                        @entry.DisplayName
                        @if (isYou)
                        {
                            <span class="badge bg-primary ms-1">You</span>
                        }
                    </td>
                    <td>@entry.TotalPoints</td>
                    <td>@entry.TotalAnswered</td>
                    <td>@(CalculateAccuracy(entry))%</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private LeaderboardModel? _leaderboard;
    private bool _loading = true;
    private string? _error;
    private string? _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            // Blazor WASM's claims factory keeps claim types as-issued (no ASP.NET Core-style
            // remapping of "sub" -> ClaimTypes.NameIdentifier happens client-side), so check
            // the raw "sub" claim to match PuckDrop.Api's User.GetUserId().
            _currentUserId = authState.User.FindFirst("sub")?.Value;

            _leaderboard = await Api.GetLeaderboardAsync();
        }
        catch (Exception)
        {
            _error = "Unable to load leaderboard. Please try again later.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string CalculateAccuracy(LeaderboardEntryModel entry) =>
        entry.TotalAnswered > 0
            ? ((double)entry.TotalPoints / entry.TotalAnswered * 100).ToString("F1")
            : "0.0";
}
