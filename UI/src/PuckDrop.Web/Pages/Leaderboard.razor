@page "/leaderboard"
@attribute [Authorize]
@inject PuckDropApiClient Api
@inject AuthenticationStateProvider AuthStateProvider

<div class="pd-page-head">
    <h1 class="pd-page-title">Leaderboard</h1>
    <p class="pd-muted lb-rule">1 point per correct pick · updated after each scored game</p>
</div>

@if (_loading)
{
    <p class="pd-muted" role="status">Loading leaderboard…</p>
}
else if (_error is not null)
{
    <div class="pd-alert pd-alert-danger" role="alert">
        <Icon Name="alert" />
        <p>@_error</p>
    </div>
}
else if (_leaderboard is null || _leaderboard.Entries.Count == 0)
{
    <p class="pd-card pd-muted lb-empty">No leaderboard data yet.</p>
}
else
{
    <section class="pd-card lb-card">
        @* One real table at every width. Below 768px, Answered and Accuracy fold into a line
           under the player's name rather than a sideways-scrolling table. *@
        <table class="pd-table lb-table">
            <caption class="pd-sr-only">Season standings, ranked by points</caption>
            <thead>
                <tr>
                    <th scope="col" class="lb-rank-col">Rank</th>
                    <th scope="col">Player</th>
                    <th scope="col" class="pd-num">Points</th>
                    <th scope="col" class="pd-num lb-wide">Answered</th>
                    <th scope="col" class="pd-num lb-wide">Accuracy</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _leaderboard.Entries.OrderBy(e => e.Rank))
                {
                    var isYou = entry.UserId == _currentUserId;
                    <tr class="@(isYou ? "pd-row-you" : null)">
                        <td class="pd-rank lb-rank">@entry.Rank</td>
                        <th scope="row">
                            <span class="lb-name">
                                @entry.DisplayName
                                @if (isYou)
                                {
                                    <span class="pd-badge pd-badge-you">You</span>
                                }
                            </span>
                            <span class="pd-muted pd-tnum lb-sub">@entry.TotalPoints of @entry.TotalAnswered correct · @CalculateAccuracy(entry)</span>
                        </th>
                        <td class="pd-num lb-points">@entry.TotalPoints</td>
                        <td class="pd-num lb-wide">@entry.TotalAnswered</td>
                        <td class="pd-num lb-wide">@CalculateAccuracy(entry)</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private LeaderboardModel? _leaderboard;
    private bool _loading = true;
    private string? _error;
    private string? _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            // Blazor WASM's claims factory keeps claim types as-issued (no ASP.NET Core-style
            // remapping of "sub" -> ClaimTypes.NameIdentifier happens client-side), so check
            // the raw "sub" claim to match PuckDrop.Api's User.GetUserId().
            _currentUserId = authState.User.FindFirst("sub")?.Value;

            _leaderboard = await Api.GetLeaderboardAsync();
        }
        catch (Exception)
        {
            _error = "Unable to load leaderboard. Please try again later.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string CalculateAccuracy(LeaderboardEntryModel entry) =>
        entry.TotalAnswered > 0
            ? $"{(double)entry.TotalPoints / entry.TotalAnswered * 100:F1}%"
            : "0.0%";
}
