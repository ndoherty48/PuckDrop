<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- "web" matches blazor-gateway locally. The S3/CloudFront publish serves from the root and
         opts out with -p:PublishForRootStaticWebAssets=true; overriding this property to empty
         doesn't work. -->
    <StaticWebAssetBasePath Condition="'$(PublishForRootStaticWebAssets)' != 'true'">web</StaticWebAssetBasePath>
    <!-- Points index.html at the content-hashed blazor.webassembly.js and fills its importmap, so
         everything under _framework/ changes name when its content does. That's what lets the S3
         publish cache _framework/ for a year (see BlazorStaticSitePublishTarget). -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Enable WebAssembly diagnostics for OpenTelemetry tracing -->
    <MetricsSupport>true</MetricsSupport>
    <EventSourceSupport>true</EventSourceSupport>
    <!-- Enable Activity/DiagnosticSource support for distributed tracing -->
    <HttpActivityPropagationSupport>true</HttpActivityPropagationSupport>
  </PropertyGroup>

  <!-- Runtime configuration options for HttpClient activity propagation -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Net.Http.EnableActivityPropagation">
      <Value>true</Value>
    </RuntimeHostConfigurationOption>
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Infrastructure\PuckDrop.ClientServiceDefaults\PuckDrop.ClientServiceDefaults.csproj" />
  </ItemGroup>

</Project>

