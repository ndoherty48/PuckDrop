<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- Conditional (not a plain assignment) so BlazorStaticSitePublishTarget's S3/CloudFront
         publish step can opt out via -p:PublishForRootStaticWebAssets=true - that build has no
         blazor-gateway sub-path convention to match (the site is served from its own CloudFront
         origin root). A Condition on StaticWebAssetBasePath itself being empty can't
         distinguish "never set" from "deliberately overridden to empty" (both look identical
         at evaluation time - confirmed directly: passing -p:StaticWebAssetBasePath= alone did
         NOT stop this project from re-assigning "web"), hence the separate boolean flag. -->
    <StaticWebAssetBasePath Condition="'$(PublishForRootStaticWebAssets)' != 'true'">web</StaticWebAssetBasePath>
    <!-- Enable WebAssembly diagnostics for OpenTelemetry tracing -->
    <MetricsSupport>true</MetricsSupport>
    <EventSourceSupport>true</EventSourceSupport>
    <!-- Enable Activity/DiagnosticSource support for distributed tracing -->
    <HttpActivityPropagationSupport>true</HttpActivityPropagationSupport>
  </PropertyGroup>

  <!-- Runtime configuration options for HttpClient activity propagation -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Net.Http.EnableActivityPropagation">
      <Value>true</Value>
    </RuntimeHostConfigurationOption>
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Infrastructure\PuckDrop.ClientServiceDefaults\PuckDrop.ClientServiceDefaults.csproj" />
  </ItemGroup>

</Project>

