@* Stroke icons on a 24px grid. Always decorative (aria-hidden) - pair with visible text, or an
   aria-label on the control that contains the icon. *@
<svg class="pd-icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">@((MarkupString)Paths[Name])</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter]
    public int Size { get; set; } = 20;

    [Parameter]
    public string? Class { get; set; }

