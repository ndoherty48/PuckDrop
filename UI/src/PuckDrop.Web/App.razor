@inject AuthConfigLoadResult AuthConfigLoadResult

@if (!AuthConfigLoadResult.Success)
{
    @* OIDC config couldn't be fetched from the API at boot (see Program.cs) - render this
       instead of the normal tree below, since AuthenticationStateProvider and friends were
       never registered in that case. MainLayout needs those too (its AuthorizeViews), so this
       draws its own brand-only header. There's no Router here either, so "Try again" is a
       plain full-page reload. *@
    <div class="pd-app">
        <header class="pd-topbar">
            <div class="pd-topbar-inner pd-on-dark">
                <span class="pd-brand">
                    <img src="logo.svg" alt="" width="32" height="32" />
                    <span>PuckDrop</span>
                </span>
            </div>
        </header>
        <main class="pd-main">
            <StatusScreen IconName="cloudOff" Title="Couldn't reach the server">
                <ChildContent>
                    <p>PuckDrop can't load right now. Please try again later.</p>
                    @if (!string.IsNullOrEmpty(AuthConfigLoadResult.ErrorMessage))
                    {
                        <p class="pd-state-detail">@AuthConfigLoadResult.ErrorMessage</p>
                    }
                </ChildContent>
                <Actions>
                    <a href="" class="pd-btn pd-btn-primary">Try again</a>
                </Actions>
            </StatusScreen>
        </main>
    </div>
}
else
{
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        @if (context.User.Identity?.IsAuthenticated == true)
                        {
                            <Unauthorized />
                        }
                        else
                        {
                            <RedirectToLogin />
                        }
                    </NotAuthorized>
                    <Authorizing>
                        <p class="pd-muted" role="status">Checking login state…</p>
                    </Authorizing>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
        </Router>
    </CascadingAuthenticationState>
}
